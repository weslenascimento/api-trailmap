{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Trailmap inventory 1.0",
  "type": "object",
  "required": ["schemaVersion", "api", "language", "scope", "preferences", "sources", "operations", "relationships", "gaps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "api": {"type": "object", "required": ["name", "baseUrl"], "properties": {"name": {"type": "string", "minLength": 1}, "baseUrl": {"type": "string"}}},
    "language": {"type": "string"},
    "scope": {"type": "string"},
    "preferences": {"type": "object", "required": ["organization", "postman", "variables", "scripts", "json", "html"], "properties": {"organization": {"enum": ["general", "category", "endpoint"]}, "postman": {"type": "boolean"}, "variables": {"type": "boolean"}, "scripts": {"type": "boolean"}, "json": {"type": "boolean"}, "html": {"type": "boolean"}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "locator", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "locator": {"type": "string"}, "status": {"enum": ["accessible", "blocked", "excluded", "unsupported"]}}}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "relationships": {"type": "array", "items": {"type": "object", "required": ["id", "from", "to", "kind", "certainty", "evidence", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "certainty": {"enum": ["documented", "observed", "inferred"]}, "evidence": {"$ref": "#/$defs/evidence"}, "description": {"type": "string", "minLength": 1}}}},
    "gaps": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "operation": {
      "type": "object",
      "required": ["id", "method", "path", "summary", "category", "evidence", "contract", "documented", "executed", "blocked", "excluded"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "TRACE", "CONNECT"]},
        "path": {"type": "string", "pattern": "^/"}, "summary": {"type": "string"}, "category": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"}, "contract": {"type": "object"},
        "documented": {"type": "boolean"}, "executed": {"type": "boolean"}, "blocked": {"type": "boolean"}, "excluded": {"type": "boolean"},
        "captures": {"type": "array", "items": {"type": "object", "required": ["variable", "pointer", "successCodes", "evidence"], "properties": {"variable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "pointer": {"type": "string", "pattern": "^/"}, "successCodes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 200, "maximum": 299}}, "evidence": {"$ref": "#/$defs/evidence"}}}}
      }
    }
  }
}
